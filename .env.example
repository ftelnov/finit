# === Secrets ===
JWT_SECRET=change-me-to-random-256-bit-key
PG_PASSWORD=change-me-to-secure-password
GRAFANA_PASSWORD=admin

# === LLM Providers (optional, configured via Router API) ===
VLLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Feature Flags ===
MLFLOW_LOG_PROMPTS=false
GUARDRAIL_INJECTION=true
GUARDRAIL_SECRETS=true

# === Limits ===
DEFAULT_MAX_TOKENS=500000
DEFAULT_MAX_ITERATIONS=3
DEFAULT_MAX_TASK_DURATION=30m
